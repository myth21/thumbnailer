APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://thumbnailer.local
APP_WORK_PATH=/data

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=thumbnailer
DB_USERNAME=
DB_PASSWORD=

EXTERNAL_DB_CONNECTION=external
EXTERNAL_DB_DRIVER=pgsql
EXTERNAL_DB_HOST=db
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_DATABASE=thumbnailer
EXTERNAL_DB_USERNAME=
EXTERNAL_DB_PASSWORD=

EXTERNAL_CONNECTION_NAME=pgsql
FILE_KEEPER=ImageNameFileKeeper

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local

EXTERNAL_FILESYSTEM_DISK=/data/upload
EXTERNAL_URL=/project-original-images

SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=rabbitmq
RABBITMQ_DSN=amqp://
RABBITMQ_HOST=10.222.33.5
RABBITMQ_PORT=5672
RABBITMQ_VHOST=thumbnailer
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=thumbnailer_exchange
RABBITMQ_QUEUE=thumbnailer_queue

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
